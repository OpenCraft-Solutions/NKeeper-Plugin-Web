<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!--
    NKeeper's own packages come from GitHub Packages, which needs a token even for public packages: set
    GITHUB_TOKEN to a token that can read packages (CI uses the workflow's own). Nothing secret lives here.
  -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    <add key="github" value="https://nuget.pkg.github.com/OpenCraft-Solutions/index.json" />
  </packageSources>

  <!-- NKeeper.* is only ever taken from GitHub Packages, and everything else only from nuget.org. -->
  <packageSourceMapping>
    <packageSource key="github">
      <package pattern="NKeeper.*" />
    </packageSource>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>

  <packageSourceCredentials>
    <github>
      <add key="Username" value="token" />
      <add key="ClearTextPassword" value="%GITHUB_TOKEN%" />
    </github>
  </packageSourceCredentials>
</configuration>
