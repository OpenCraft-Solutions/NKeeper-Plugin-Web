<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <OutputType>Exe</OutputType>
    <!-- Test names use underscores; inline test-data arrays (CA1861) are clearer than static fields. -->
    <NoWarn>$(NoWarn);CA1707;CA2234;CA1861</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- The target server the tests proxy to is a small Kestrel host. -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <PackageReference Include="NKeeper.Testing" />
    <PackageReference Include="Npgsql" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="xunit.runner.visualstudio">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <!--
      The plugin is built, packed and signed first (into ../artifacts/plugins, with the development key in
      ../.dev/keys), and the tests load that package. It isn't referenced as an assembly: the test server loads it
      from the package, as NKeeper loads any plugin.
    -->
    <ProjectReference Include="..\backend\NKeeper.Plugins.Web.csproj" ReferenceOutputAssembly="false" />
  </ItemGroup>

</Project>
